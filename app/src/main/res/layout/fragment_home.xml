<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_margin">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:contentDescription="@string/loading"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.NakshatraCalendar.Body"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="@string/error_generic" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textAppearance="@style/TextAppearance.NakshatraCalendar.Headline" />

            <TextView
                android:id="@+id/gregorian_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg"
                android:textAppearance="@style/TextAppearance.NakshatraCalendar.Body"
                tools:text="Saturday, 14 November 2026" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_malayalam_date_label"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Label" />

                    <TextView
                        android:id="@+id/malayalam_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.MalayalamDisplay"
                        tools:text="കൊല്ലവർഷം 1202 തുലാം 28" />

                    <TextView
                        android:id="@+id/malayalam_date_english"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Body"
                        tools:text="28 Thulam 1202 ME" />

                    <TextView
                        android:id="@+id/malayalam_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Label"
                        tools:text="തുലാം · Thulam · Kollavarsham 1202" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_nakshatra_label"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Label" />

                    <TextView
                        android:id="@+id/nakshatra_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.MalayalamDisplay"
                        tools:text="ചിത്തിര · Chithira" />

                    <TextView
                        android:id="@+id/nakshatra_until"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Body"
                        tools:text="Until 15 Nov, 09:12" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_upcoming_label"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Label" />

                    <TextView
                        android:id="@+id/family_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Body"
                        tools:text="0 family members" />

                    <TextView
                        android:id="@+id/upcoming_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/home_upcoming_empty"
                        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Label" />

                    <LinearLayout
                        android:id="@+id/upcoming_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_add_person"
                style="@style/Widget.NakshatraCalendar.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_add_person"
                app:icon="@drawable/ic_family" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_view_calendar"
                style="@style/Widget.NakshatraCalendar.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_view_calendar"
                app:icon="@drawable/ic_calendar" />

            <Button
                android:id="@+id/action_sync_history"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/history_title" />
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
