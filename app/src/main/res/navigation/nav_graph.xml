<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment android:id="@+id/homeFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.home.HomeFragment" android:label="@string/nav_home">
        <action android:id="@+id/action_home_to_person_edit" app:destination="@id/personEditFragment" />
    </fragment>

    <fragment android:id="@+id/familyFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.person.FamilyFragment" android:label="@string/nav_family">
        <action android:id="@+id/action_family_to_person_edit" app:destination="@id/personEditFragment" />
        <action android:id="@+id/action_family_to_find_dates" app:destination="@id/findDatesFragment" />
    </fragment>

    <fragment android:id="@+id/calendarFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.calendar.CalendarFragment" android:label="@string/nav_calendar" />

    <fragment android:id="@+id/settingsFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.settings.SettingsFragment" android:label="@string/nav_settings" />

    <!-- Add (personId = -1) or edit a family member. -->
    <fragment android:id="@+id/personEditFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.person.PersonEditFragment" android:label="@string/person_add_title">
        <argument android:name="personId" app:argType="long" android:defaultValue="-1L" />
    </fragment>

    <!-- Find Nakshatra dates in a range; personId preselects one member (-1 = everyone). -->
    <fragment android:id="@+id/findDatesFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.finddates.FindDatesFragment" android:label="@string/find_title">
        <argument android:name="personId" app:argType="long" android:defaultValue="-1L" />
        <action android:id="@+id/action_find_dates_to_preview" app:destination="@id/eventPreviewFragment" />
    </fragment>

    <!-- Google Calendar (Sprint 4) -->
    <fragment android:id="@+id/eventPreviewFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.sync.EventPreviewFragment" android:label="@string/preview_title">
        <argument android:name="personId" app:argType="long" />
        <argument android:name="startEpochDay" app:argType="long" />
        <argument android:name="endEpochDay" app:argType="long" />
        <action android:id="@+id/action_preview_to_result" app:destination="@id/syncResultFragment" />
    </fragment>

    <fragment android:id="@+id/googleAccountFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.sync.GoogleAccountFragment" android:label="@string/account_title" />

    <fragment android:id="@+id/syncResultFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.sync.SyncResultFragment" android:label="@string/result_title">
        <argument android:name="syncId" app:argType="long" />
    </fragment>

    <fragment android:id="@+id/syncHistoryFragment" android:name="io.github.anjalymsajeev.nakshatracalendar.feature.sync.SyncHistoryFragment" android:label="@string/history_title">
        <action android:id="@+id/action_history_to_result" app:destination="@id/syncResultFragment" />
    </fragment>

    <action android:id="@+id/action_global_google_account" app:destination="@id/googleAccountFragment" />
    <action android:id="@+id/action_global_sync_history" app:destination="@id/syncHistoryFragment" />
</navigation>
