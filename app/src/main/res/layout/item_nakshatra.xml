<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_xs">

    <TextView
        android:id="@+id/number"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Label" />

    <TextView
        android:id="@+id/name_malayalam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.NakshatraCalendar.MalayalamDisplay"
        android:textSize="18sp"
        android:lineHeight="28sp" />

    <TextView
        android:id="@+id/name_english"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_sm"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.NakshatraCalendar.Body" />

    <ImageView
        android:id="@+id/check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        android:visibility="invisible" />
</LinearLayout>
